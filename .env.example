# Live runtime: installed Pi + pi-web-access + inherited OpenAI Codex subscription auth.
PORT=4173
HOST=127.0.0.1
DATA_DIR=./data/sessions
PI_EXECUTABLE=pi
PI_PROJECT_DIR=/home/chetan/pi_frontier
PI_WEB_SEARCH_EXTENSION=$HOME/.pi/agent/npm/node_modules/pi-web-access/index.ts
PI_PROVIDER=openai-codex
PI_MODEL=gpt-5.6-luna
PI_THINKING=xhigh
PI_TIMEOUT_MS=1800000
PI_MAX_CONCURRENT_WORKERS=1
PI_MAX_CONTENT_CALLS=32
MAX_SEARCH_CALLS=8
MAX_SOURCES=28
MAX_CLAIMS=6
MAX_FOLLOW_UPS=2
MAX_RESEARCH_ITERATIONS=2

# Fixture search/provider variables are for explicitly injected tests only.
SEARCH_PROVIDER=auto
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=
